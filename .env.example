# =============================================================
# MoveHaus Training Club — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione .env.local.
# =============================================================

# --- Supabase (públicas, vão para o navegador) ---
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="chave-anon-ou-publishable"

# URL pública do site (usada em redirects de auth e links de pagamento)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase (servidor, NUNCA expor) ---
# Ignora RLS: usar apenas em webhooks/jobs/ações administrativas.
SUPABASE_SERVICE_ROLE_KEY="chave-service-role-ou-secret"

# --- Mercado Pago (servidor, NUNCA expor) ---
# Deixe em branco para desenvolver a camada de integração sem pagar de verdade.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Public Key do formulário integrado (pública; pode ser enviada ao navegador)
MERCADOPAGO_PUBLIC_KEY=""
# Credenciais OAuth opcionais; não utilizadas no checkout integrado
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
# WEBHOOK_SECRET é a assinatura gerada em Suas integrações > Webhooks, não o Client Secret.
